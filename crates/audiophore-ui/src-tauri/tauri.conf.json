{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audiophore",
  "version": "0.1.0",
  "identifier": "dev.audiophore.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Audiophore",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "shortDescription": "Low-latency bridge from Synesthesia VJ to lighting/laser ecosystems.",
    "longDescription": "Audiophore translates Synesthesia OSC into Hue Entertainment, Nanoleaf Streaming, WLED (sACN/E1.31/DDP), Art-Net DMX, Ether Dream lasers, and generic OSC pass-through.",
    "copyright": "Copyright (c) 2026 Aaron Cupp",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
